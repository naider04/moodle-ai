# Copy this file to .env and fill in your values. NEVER commit .env.

# Port for local development (Render sets PORT automatically)
PORT=3000

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Default Moodle site pre-filled in the login form (optional)
DEFAULT_SITE=https://aulagradoa.unemi.edu.ec

# Default username pre-filled in the login form (optional)
DEFAULT_USERNAME=

# Web service to use at login (must be enabled on your Moodle server)
WS_SERVICE=moodle_mobile_app

# --- AI Assistant (optional) ---
# NVIDIA NIM API key, e.g. from https://build.nvidia.com
NVIDIA_API_KEY=

# Model to use for the assistant (defaults to stepfun-ai/step-3.7-flash)
AI_MODEL=stepfun-ai/step-3.7-flash

# Max tool-call turns per assistant reply
AI_MAX_TURNS=8
